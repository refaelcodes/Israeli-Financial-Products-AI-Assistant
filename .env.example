# ── AI provider for "Client Questions" (NL -> SQL) ───────────
# AI_MODE: mock | api | sdk
#   mock — offline, deterministic heuristic SQL (default; no key needed)
#   api  — Anthropic Messages API (needs ANTHROPIC_API_KEY; billed)
#   sdk  — Claude Agent SDK via a local Claude subscription (`claude` login)
AI_MODE=mock
# Claude model id: claude-opus-4-8 | claude-sonnet-5 | claude-haiku-4-5 | claude-fable-5
AI_MODEL=claude-opus-4-8
# Only needed for AI_MODE=api (can also be entered in the UI instead)
ANTHROPIC_API_KEY=

# ── Server ───────────────────────────────────────────────────
FUND_AI_HOST=0.0.0.0
FUND_AI_PORT=5000
# Enable Flask auto-reload/debug (true only for local development)
FLASK_DEBUG=false
# Comma-separated allowed CORS origins, or "*" to allow all
CORS_ORIGINS=http://localhost:5173

# ── Authentication ───────────────────────────────────────────
# Secret used to sign JWT tokens — set to a long random string
JWT_SECRET=
# Seed user created on first run (when the users table is empty)
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=
AUTH_DEFAULT_EMAIL=
AUTH_DEFAULT_NAME=Administrator
